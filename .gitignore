# =============================
# OURLETTE — .gitignore
# =============================

# ── Secrets & Environnement ──────────────────────────────────────
.env
.env.local
.env.development
.env.production
.env.staging
.env*.local
!.env.example

# ── Configurations IA ────────────────────────────────────────────
.directives-IA
.landing-page

# ── Next.js ──────────────────────────────────────────────────────
.next/
out/
build/

# ── Node.js ──────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Logs ─────────────────────────────────────────────────────────
logs/
*.log

# ── OS ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo

# ── IDE ──────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# ── TypeScript build cache ────────────────────────────────────────
*.tsbuildinfo

# ── SÉCURITÉ : ne jamais committer ces fichiers ──────────────────
# (clés API, tokens, mots de passe)
*.pem
*.key
*.p12
*.pfx
secrets.json
