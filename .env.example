# ============================================================
# OURLETTE — Variables d'environnement (Template)
# ============================================================
# Copiez ce fichier en `.env.local` et renseignez vos valeurs réelles.
# Ce fichier exemple est versionné dans Git (ne JAMAIS y placer de vraies clés).
# ============================================================

# ── 1. Supabase ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Strictement réservé au backend serveur (Webhooks, Admin) — JAMAIS de préfixe NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── 2. PowerSync (Mode Hors Ligne) ──────────────────────────
NEXT_PUBLIC_POWERSYNC_URL=https://votre-instance.powersync.journeyapps.com

# ── 3. URL de l'Application ─────────────────────────────────
# En local : http://localhost:3000 | En production : https://ourlette.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── 4. Passerelle de Paiement SasPay v1 ─────────────────────
# Clé API secrète (sk_test_... en dév, sk_live_... en prod) — serveur uniquement
SASPAY_API_KEY=sk_test_...
# Secret de vérification HMAC des webhooks — serveur uniquement
SASPAY_WEBHOOK_SECRET=whsec_...

# ── 5. Notifications (Gmail SMTP & Telegram Bot) ───────────
# Adresse Gmail et Mot de passe d'application (App Password)
GMAIL_USER=votre-email@gmail.com
GMAIL_APP_PASSWORD=votre-mot-de-passe-application
# Token du bot Telegram et ID du canal/chat de notification
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789
